    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)
    myChar = newChar
    myRoot = newChar:WaitForChild("HumanoidRootPart")
    myHum = newChar:WaitForChild("Humanoid")
    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)
    myHum.Died:Connect(onDied)
end)
