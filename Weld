-- // Death + Respawn fix
local function onDied()
    if active then
        Stop()
        active = false
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
    end
end

myHum.Died:Connect(onDied)

