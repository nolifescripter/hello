local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local me = Players.LocalPlayer
local myChar = me.Character or me.CharacterAdded:Wait()
local myRoot = myChar:WaitForChild("HumanoidRootPart")
local myHum = myChar:WaitForChild("Humanoid")

local con = nil
local savedPos = nil
local active = false
local uiVisible = true
local currentMode = "bodyblock"
local targetName = ""

local offsets = {
    bodyblock  = { pos = Vector3.new(0, 0, -3),      rot = CFrame.Angles(0, 0, 0) },
    softblock  = { pos = Vector3.new(0, 0, -1.2),    rot = CFrame.Angles(0, 0, 0) },
    shield     = { pos = Vector3.new(0, -1.5, -1.2), rot = CFrame.Angles(0, 0, 0) },
    headsit    = { pos = Vector3.new(0, 3, 0.9),     rot = CFrame.Angles(0, 0, 0) },
    elevator   = { pos = Vector3.new(0, -3, 0),      rot = CFrame.Angles(math.rad(-90), 0, math.rad(3)) },
    nojump     = { pos = Vector3.new(0, 3.5, 0),     rot = CFrame.Angles(math.rad(-90), 0, 0) },
    fast       = { pos = Vector3.new(0, 0, 2),       rot = CFrame.Angles(0, 0, 0) },
    medium     = { pos = Vector3.new(0, 0, 2),       rot = CFrame.Angles(0, 0, 0) },
    slow       = { pos = Vector3.new(0, 0, 2),       rot = CFrame.Angles(0, 0, 0) },
}

local speeds = { fast = 50, medium = 24, slow = 10 }

local function Stop()
    if con then con:Disconnect() con = nil end
    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)
    task.wait()
    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)
    if savedPos and myRoot and myRoot.Parent then
        myRoot.CFrame = savedPos
        myRoot.AssemblyLinearVelocity = Vector3.new()
        myRoot.AssemblyAngularVelocity = Vector3.new()
    end
    savedPos = nil
    if myHum and myHum.Parent then
        myHum.WalkSpeed = 16
    end
end

local function Start()
    if con then con:Disconnect() con = nil end

    local target = Players:FindFirstChild(targetName)
    if not target or not target.Character then return end

    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    local tHum = target.Character:FindFirstChild("Humanoid")
    if not tRoot then return end

    savedPos = myRoot.CFrame

    if speeds[currentMode] then
        myHum.WalkSpeed = speeds[currentMode]
    elseif tHum then
        myHum.WalkSpeed = tHum.WalkSpeed
    end

    local offset = offsets[currentMode]

    con = RunService.Heartbeat:Connect(function()
        if not myRoot or not myRoot.Parent or myHum.Health <= 0 then
            Stop() return
        end

        if not tRoot or not tRoot:IsDescendantOf(workspace) then
            tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not tRoot then return end
        end

        if speeds[currentMode] and tHum then
            myHum.WalkSpeed = tHum.WalkSpeed + 5
        end

        pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", tRoot) end)

        myRoot.CFrame = tRoot.CFrame * CFrame.new(offset.pos) * offset.rot
        myRoot.AssemblyLinearVelocity = Vector3.new()
        myRoot.AssemblyAngularVelocity = Vector3.new()
    end)
end

-- // UI
local screenGui = Instance.new("ScreenGui")
screenGui.ResetOnSpawn = false
screenGui.Parent = me.PlayerGui

local hideBtn = Instance.new("TextButton")
hideBtn.Size = UDim2.new(0, 80, 0, 28)
hideBtn.Position = UDim2.new(0, 20, 0.3, -35)
hideBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
hideBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
hideBtn.Text = "Hide UI"
hideBtn.Font = Enum.Font.GothamBold
hideBtn.TextSize = 12
hideBtn.Parent = screenGui
Instance.new("UICorner", hideBtn).CornerRadius = UDim.new(0, 6)

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 340)
frame.Position = UDim2.new(0, 20, 0.3, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BorderSizePixel = 0
frame.Parent = screenGui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Text = "Weld Abuse"
title.Font = Enum.Font.GothamBold
title.TextSize = 15
title.Parent = frame
Instance.new("UICorner", title).CornerRadius = UDim.new(0, 10)

local nameBox = Instance.new("TextBox")
nameBox.Size = UDim2.new(1, -20, 0, 35)
nameBox.Position = UDim2.new(0, 10, 0, 45)
nameBox.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
nameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
nameBox.PlaceholderText = "Enter username..."
nameBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
nameBox.Text = ""
nameBox.Font = Enum.Font.Gotham
nameBox.TextSize = 13
nameBox.ClearTextOnFocus = false
nameBox.Parent = frame
Instance.new("UICorner", nameBox).CornerRadius = UDim.new(0, 6)

nameBox:GetPropertyChangedSignal("Text"):Connect(function()
    targetName = nameBox.Text
end)

local modes = {"bodyblock", "softblock", "shield", "headsit", "elevator", "nojump", "fast", "medium", "slow"}
local modeButtons = {}

for i, mode in ipairs(modes) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, -15, 0, 28)
    btn.Position = UDim2.new(((i-1) % 2) * 0.5, ((i-1) % 2 == 0) and 10 or 5, 0, 90 + math.floor((i-1)/2) * 34)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Text = mode
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    modeButtons[mode] = btn

    btn.MouseButton1Click:Connect(function()
        currentMode = mode
        for m, b in pairs(modeButtons) do
            b.BackgroundColor3 = m == mode
                and Color3.fromRGB(80, 120, 255)
                or Color3.fromRGB(50, 50, 50)
        end
        if active then Start() end
    end)
end

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(1, -20, 0, 38)
toggle.Position = UDim2.new(0, 10, 0, 282)
toggle.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.Text = "OFF"
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 14
toggle.Parent = frame
Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 6)

toggle.MouseButton1Click:Connect(function()
    active = not active
    if active then
        Start()
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    else
        Stop()
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
    end
end)

hideBtn.MouseButton1Click:Connect(function()
    uiVisible = not uiVisible
    frame.Visible = uiVisible
    hideBtn.Text = uiVisible and "Hide UI" or "Show UI"
end)

modeButtons["bodyblock"].BackgroundColor3 = Color3.fromRGB(80, 120, 255)

-- // Death + Respawn fix
local function onDied()
    if active then
        Stop()
        active = false
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
    end
end

myHum.Died:Connect(onDied)

me.CharacterAdded:Connect(function(newChar)
    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)

    myChar = newChar
    myRoot = newChar:WaitForChild("HumanoidRootPart")
    myHum = newChar:WaitForChild("Humanoid")

    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)

    myHum.Died:Connect(onDied)
end)
