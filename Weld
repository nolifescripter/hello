-- // Mode buttons
local modes = {"bodyblock", "softblock", "shield", "headsit", "elevator", "nojump", "fast", "medium", "slow"}
local modeButtons = {}
local lastTap = {}

for i, mode in ipairs(modes) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, -15, 0, 28)
    btn.Position = UDim2.new(((i-1) % 2) * 0.5, ((i-1) % 2 == 0) and 10 or 5, 0, 210 + math.floor((i-1)/2) * 34)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Text = mode
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    modeButtons[mode] = btn

    btn.MouseButton1Click:Connect(function()
        local now = tick()
        local last = lastTap[mode] or 0
        if now - last < 0.35 then
            customOffset = nil
            local o = offsets[mode]
            axisBoxes["X"].Text = tostring(o.pos.X)
            axisBoxes["Y"].Text = tostring(o.pos.Y)
            axisBoxes["Z"].Text = tostring(o.pos.Z)
            xyzPanel.Visible = true
        else
            xyzPanel.Visible = false
            customOffset = nil
            currentMode = mode
            for m, b in pairs(modeButtons) do
                b.BackgroundColor3 = m == mode
                    and Color3.fromRGB(80, 120, 255)
                    or Color3.fromRGB(50, 50, 50)
            end
            if active then Start() end
        end
        lastTap[mode] = now
    end)
end

