local modeButtons = {}
local lastTap = {}

local function buildPage(pageIndex)
    for _, c in pairs(pageContainers) do c:Destroy() end
    pageContainers = {}

    local page = pages[pageIndex]
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, 300)
    container.Position = UDim2.new(0, 10, 0, 118)
    container.BackgroundTransparency = 1
    container.Parent = frame
    table.insert(pageContainers, container)

    modeButtons = {}

    for i, mode in ipairs(page.modes) do
        local btn = Instance.new("TextButton")
        local isLocked = lockedModes[mode]

        if isLocked then
            btn.Size = UDim2.new(1, 0, 0, 50)
            btn.Position = UDim2.new(0, 0, 0, math.floor((i-1)) * 56)
            btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        else
            btn.Size = UDim2.new(0.5, -6, 0, 30)
            btn.Position = UDim2.new(((i-1) % 2) * 0.5, ((i-1) % 2 == 0) and 0 or 6, 0, math.floor((i-1)/2) * 36)
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        end

        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.Text = isLocked and "NaN Fling\n(one shot)" or mode
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.Parent = container
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        modeButtons[mode] = btn

        if mode == currentMode and not isLocked then
            btn.BackgroundColor3 = Color3.fromRGB(80, 120, 255)
        end

        btn.MouseButton1Click:Connect(function()
            if isLocked then
                doNaNFling()
                return
            end

            local now = tick()
            local last = lastTap[mode] or 0
            if now - last < 0.35 then
                customOffset = nil
                customRot = nil
                local o = offsets[mode]
                axisBoxes["X"].Text = tostring(o.pos.X)
                axisBoxes["Y"].Text = tostring(o.pos.Y)
                axisBoxes["Z"].Text = tostring(o.pos.Z)
                rotBoxes["RX"].Text = tostring(o.rot.X)
                rotBoxes["RY"].Text = tostring(o.rot.Y)
                rotBoxes["RZ"].Text = tostring(o.rot.Z)
                xyzPanel.Visible = true
            else
                xyzPanel.Visible = false
                customOffset = nil
                customRot = nil
                currentMode = mode
                for m, b in pairs(modeButtons) do
                    b.BackgroundColor3 = m == mode
                        and Color3.fromRGB(80, 120, 255)
                        or Color3.fromRGB(50, 50, 50)
                end
                if active then Start() end
            end
            lastTap[mode] = now
        end)
    end
end

