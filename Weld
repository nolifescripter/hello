local function makeDraggable(dragHandle, dragTarget)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local lastGoalPos = nil
    local DRAG_SPEED = 8

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = dragTarget.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local delta = input.Position - dragStart
                lastGoalPos = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    RunService.Heartbeat:Connect(function(dt)
        if not startPos then return end
        if lastGoalPos then
            dragTarget.Position = UDim2.new(
                dragTarget.Position.X.Scale,
                dragTarget.Position.X.Offset + (lastGoalPos.X.Offset - dragTarget.Position.X.Offset) * math.min(dt * DRAG_SPEED * 60, 1),
                dragTarget.Position.Y.Scale,
                dragTarget.Position.Y.Offset + (lastGoalPos.Y.Offset - dragTarget.Position.Y.Offset) * math.min(dt * DRAG_SPEED * 60, 1)
            )
        end
    end)
end

