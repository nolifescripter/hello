local currentMode = "bodyblock"
local targetName = ""
local customOffset = nil

local offsets = {
    bodyblock  = { pos = Vector3.new(0, 0, -3),      rot = CFrame.Angles(0, 0, 0) },
    softblock  = { pos = Vector3.new(0, 0, -1.2),    rot = CFrame.Angles(0, 0, 0) },
    shield     = { pos = Vector3.new(0, -1.5, -1.2), rot = CFrame.Angles(0, 0, 0) },
    headsit    = { pos = Vector3.new(0, 3, 0.9),     rot = CFrame.Angles(0, 0, 0) },
    elevator   = { pos = Vector3.new(0, -3, 0),      rot = CFrame.Angles(math.rad(-90), 0, math.rad(3)) },
    nojump     = { pos = Vector3.new(0, 3.5, 0),     rot = CFrame.Angles(math.rad(-90), 0, 0) },
    fast       = { pos = Vector3.new(0, 0, 2),       rot = CFrame.Angles(0, 0, 0) },
    medium     = { pos = Vector3.new(0, 0, 2),       rot = CFrame.Angles(0, 0, 0) },
    slow       = { pos = Vector3.new(0, 0, 2),       rot = CFrame.Angles(0, 0, 0) },
}

local speeds = { fast = 50, medium = 24, slow = 10 }

local function getOffset()
    if customOffset then
        return { pos = customOffset, rot = CFrame.Angles(0, 0, 0) }
    end
    return offsets[currentMode]
end

local function Stop()
    if con then con:Disconnect() con = nil end
    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)
    task.wait()
    pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)
    if savedPos and myRoot and myRoot.Parent then
        myRoot.CFrame = savedPos
        myRoot.AssemblyLinearVelocity = Vector3.new()
        myRoot.AssemblyAngularVelocity = Vector3.new()
    end
    savedPos = nil
    if myHum and myHum.Parent then
        myHum.WalkSpeed = 16
    end
end

local function findPlayer(query)
    query = query:lower():gsub("%s+", "")
    if query == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == me then continue end
        if p.Name:lower():find(query) or p.DisplayName:lower():find(query) then
            return p
        end
    end
    return nil
end

local function Start()
    if con then con:Disconnect() con = nil end
    local target = findPlayer(targetName)
    if not target or not target.Character then return end
    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    local tHum = target.Character:FindFirstChild("Humanoid")
    if not tRoot then return end
    savedPos = myRoot.CFrame
    if speeds[currentMode] then
        myHum.WalkSpeed = speeds[currentMode]
    elseif tHum then
        myHum.WalkSpeed = tHum.WalkSpeed
    end
    con = RunService.Heartbeat:Connect(function()
        if not myRoot or not myRoot.Parent or myHum.Health <= 0 then Stop() return end
        if not tRoot or not tRoot:IsDescendantOf(workspace) then
            tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not tRoot then return end
        end
        if speeds[currentMode] and tHum then
            myHum.WalkSpeed = tHum.WalkSpeed + 5
        end
        local offset = getOffset()
        pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", tRoot) end)
        myRoot.CFrame = tRoot.CFrame * CFrame.new(offset.pos) * offset.rot
        myRoot.AssemblyLinearVelocity = Vector3.new()
        myRoot.AssemblyAngularVelocity = Vector3.new()
    end)
end

